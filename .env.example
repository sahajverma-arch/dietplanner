# Supabase — Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service role key — ONLY needed locally to run `npm run seed:foods`
# (writes the foods reference table). Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# NVIDIA NIM — create a key at https://build.nvidia.com (server-side only, never exposed to the browser)
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Counselling sheet sync (Today's Activity tab)
# Preferred: private access via a Google service account that the sheet is
# shared with (Viewer). Enable the Google Sheets API in the same GCP project.
GOOGLE_SERVICE_ACCOUNT_EMAIL=sheet-sync@your-project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
COUNSELLING_SHEET_ID=your-sheet-id
# COUNSELLING_SHEET_RANGE=Raw_Counselling
# Fallback (only works while the sheet is link-viewable):
# COUNSELLING_SHEET_CSV_URL=https://docs.google.com/spreadsheets/d/<SHEET_ID>/export?format=csv&gid=0
# Shared secret QStash sends to /api/sync-counselling (x-cron-secret header or ?secret=)
CRON_SECRET=

# Model, and the fallback used automatically when it is congested or fails
# validation. The two MUST differ — callNim skips the fallback path when they
# match. NVIDIA retires models with no notice (mistral-small-4 went 410 Gone
# mid-project), so verify both before relying on them:
#   npx tsx scripts/bench-nim-models.ts
# It generates a full 7-day plan per model and prints a league table.
NVIDIA_MODEL=meta/llama-3.1-8b-instruct
NVIDIA_FALLBACK_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1

# Optional overrides
# NVIDIA_NIM_URL=https://integrate.api.nvidia.com/v1/chat/completions
# Per-call timeout in ms (default 120000). A congestion setting, not a model
# property: these endpoints answer a short prompt in ~2s and the full plan
# prompt in anywhere from 40s to several minutes. generate-plan makes TWO
# sequential calls under maxDuration=300, so much above 140000 only moves the
# failure from the model call to the route.
# NVIDIA_TIMEOUT_MS=120000
